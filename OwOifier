local function animFocus(on)
    TweenService:Create(mainFrame, TweenInfo.new(0.18), {
        BackgroundTransparency = on and 0.2 or 0.4,
        Size = UDim2.new(mainFrame.Size.X.Scale, 0, 0, on and 50 or 42)
    }):Play()
end

tb.Focused:Connect(function() animFocus(true) end)
tb.FocusLost:Connect(function() animFocus(false) end)

local function sendOwO()
    local msg = tb.Text
    if msg:match("^%s*$") then return end
    
    local owoMsg = owoify(msg)
    
    local channel = TextChatService.ChatInputBarConfiguration.TargetTextChannel
    if not channel then
        channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral") 
             or TextChatService.TextChannels:FindFirstChildWhichIsA("TextChannel")
    end
    
    if channel then
        pcall(function()
            channel:SendAsync(owoMsg)
        end)
        tb.Text = ""
    end
end

tb.FocusLost:Connect(function(enter) if enter then sendOwO() end end)
sendBtn.MouseButton1Click:Connect(sendOwO)

