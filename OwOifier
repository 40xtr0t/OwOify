local function owoify(text)
    if not text or text:match("^%s*$") then return text end
    
    local t = text:lower()
    t = t:gsub("[rl]", "w")
    t = t:gsub("n([aeiou])", "ny%1")
    t = t:gsub("ove", "uv")
    t = t:gsub("you", "chu")
    t = t:gsub("are", "awe")
    t = t:gsub("the", "da")
    t = t:gsub("what", "nani")
    t = t:gsub("please", "pwease")
    t = t:gsub("sorry", "sowwy")
    t = t:gsub("love", "wuv")
    t = t:gsub("hi", "haii")
    t = t:gsub("hello", "hewwo")
    
    local faces = {" OwO", " UwU", " ^w^", " >w<", " :3", " ;w;", "~", " owo", " uwu", "!"}
    if math.random() < 0.65 then
        t = t .. faces[math.random(1, #faces)]
    end
    
    local owo = t:gsub("^%l", string.upper)
    
    local words = {}
    for w in owo:gmatch("%S+") do
        table.insert(words, w)
    end
    
    if #words > 0 then
        local first = words[1]
        local prefix_len = math.random(1, 2)
        local prefix = first:sub(1, prefix_len):lower()
        words[1] = prefix .. "-" .. prefix .. first:sub(prefix_len + 1)
    end
    
    for i = 2, #words do
        local w = words[i]
        if math.random() < 0.3 and #w > 3 then
            local prefix_len = math.random(1, 2)
            local prefix = w:sub(1, prefix_len):lower()
            words[i] = prefix .. "-" .. prefix .. w:sub(prefix_len + 1)
        end
    end
    
    local stuttered = table.concat(words, " ")
    return stuttered:gsub("^%l", string.upper)
end

